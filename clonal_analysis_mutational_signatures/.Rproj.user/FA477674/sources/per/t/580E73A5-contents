# 19. Predefined process-level contributions

process_from_contributions <- function(df, scope) {
  df %>%
    dplyr::group_by(
      dplyr::across(
        dplyr::all_of(
          intersect(
            c("patient", "classification", "n_snvs", "confidence", "cosine_similarity"),
            names(df)
          )
        )
      )
    ) %>%
    dplyr::summarise(
      age_related = if (all(is.na(relative_contribution))) {
        NA_real_
      } else {
        sum(relative_contribution[signature %in% AGE_RELATED_SIGNATURES], na.rm = TRUE)
      },
      
      APOBEC = if (all(is.na(relative_contribution))) {
        NA_real_
      } else {
        sum(relative_contribution[signature %in% APOBEC_SIGNATURES], na.rm = TRUE)
      },
      
      .groups = "drop"
    ) %>%
    tidyr::pivot_longer(
      c(age_related, APOBEC),
      names_to = "process",
      values_to = "relative_contribution"
    ) %>%
    dplyr::mutate(scope = scope)
}

