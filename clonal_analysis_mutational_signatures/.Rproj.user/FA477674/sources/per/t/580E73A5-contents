# step8_cluster_mutational_signatures.R

# Purpose:
#   Characterize mutational signatures in shared, tumor-specific and
#   NAT-specific PyClone-VI clonal compartments.

# Analysis:
#   - assign each mutation to its PyClone-VI clonal class
#   - construct 96-channel SBS spectra per patient x clonal class
#   - construct pooled spectra for each clonal class
#   - fit selected COSMIC v3.2 SBS signatures using MutationalPatterns
#   - calculate reconstruction cosine similarity
#   - compare relative signature contributions between clonal classes
#     using paired Wilcoxon signed-rank tests

# Signature panel:
#   Age-related: SBS1, SBS5, SBS40
#   APOBEC:      SBS2, SBS13
#   Tobacco:     SBS92

# Predefined process-level scores:
#   Age-related = SBS1 + SBS5 + SBS40
#   APOBEC      = SBS2 + SBS13

# 1. Packages

suppressPackageStartupMessages({
  library(tidyverse)
  library(MutationalPatterns)
  library(GenomicRanges)
  library(IRanges)
  library(GenomeInfoDb)
  library(BSgenome.Hsapiens.UCSC.hg38)
})


# 2. Paths

