# 14. Signature fitting helper

fit_signature_matrix <- function(mut_mat) {
  signatures <- all_signatures[, SIGNATURE_PANEL, drop = FALSE]
  
  if (nrow(signatures) != 96 || nrow(mut_mat) != 96) {
    stop("Signature and mutation matrices must both contain 96 contexts.", call. = FALSE)
  }
  
  # MutationalPatterns uses the same canonical 96-context ordering for both
  # matrices, but the package reference may use different row labels.
  rownames(signatures) <- rownames(mut_mat)
  
  fit <- MutationalPatterns::fit_to_signatures_strict(
    mut_matrix = mut_mat,
    signatures = signatures,
    max_delta = MAX_DELTA
  )
  
  fitted_contrib <- fit$fit_res$contribution
  
  abs_contrib <- matrix(
    0,
    nrow = length(SIGNATURE_PANEL),
    ncol = ncol(mut_mat),
    dimnames = list(SIGNATURE_PANEL, colnames(mut_mat))
  )
  
  common_signatures <- intersect(rownames(fitted_contrib), SIGNATURE_PANEL)
  common_profiles <- intersect(colnames(fitted_contrib), colnames(mut_mat))
  
  abs_contrib[common_signatures, common_profiles] <-
    fitted_contrib[common_signatures, common_profiles, drop = FALSE]
  
  totals <- colSums(abs_contrib)
  rel_contrib <- sweep(abs_contrib, 2, totals, "/")
  rel_contrib[, totals == 0] <- NA_real_
  
  reconstructed <- signatures %*% abs_contrib
  
  cosines <- vapply(seq_len(ncol(mut_mat)), function(i) {
    cosine_similarity(mut_mat[, i], reconstructed[, i])
  }, numeric(1))
  
  qc <- tibble::tibble(
    profile_id = colnames(mut_mat),
    n_snvs = colSums(mut_mat),
    cosine_similarity = cosines
  )
  
  list(
    absolute = abs_contrib,
    relative = rel_contrib,
    reconstructed = reconstructed,
    qc = qc
  )
}


