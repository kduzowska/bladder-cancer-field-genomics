CLUSTER_SUMMARY <- "~/bladder-cancer-field-genomics/clonal_analysis_mutational_patterns/results/step6_pyclone_analysis/pyclone_cluster_summary.tsv"
OUT_DIR <- "~/bladder-cancer-field-genomics/clonal_analysis_mutational_patterns/results/step8_cluster_mut_sig"
dir.create(OUT_DIR, recursive = TRUE, showWarnings = FALSE)


# 3. Analysis settings

REF_GENOME <- BSgenome.Hsapiens.UCSC.hg38
COSMIC_SOURCE <- "COSMIC_v3.2"
REFERENCE_GENOME <- "GRCh38"
MAX_DELTA <- 0.004

SIGNATURE_PANEL <- c(
  "SBS1", "SBS5", "SBS40",
  "SBS2", "SBS13",
  "SBS92"
)

AGE_RELATED_SIGNATURES <- c("SBS1", "SBS5", "SBS40")
APOBEC_SIGNATURES <- c("SBS2", "SBS13")

CLASS_LEVELS <- c(
  "shared",
  "tumor_specific",
  "NAT_specific"
)

STD_CHR <- paste0("chr", c(1:22, "X", "Y"))


# 4. Helper functions

confidence_from_count <- function(n) {
  dplyr::case_when(
    n > 100 ~ "high",
    n >= 50 ~ "medium",
    n >= 1 ~ "low",
    TRUE ~ "no_mutations"
  )
}


cosine_similarity <- function(a, b) {
  if (sum(a) == 0 || sum(b) == 0) return(NA_real_)
  sum(a * b) / (sqrt(sum(a^2)) * sqrt(sum(b^2)))
}


make_granges <- function(tb) {
  gr <- GenomicRanges::GRanges(
    seqnames = tb$chr,
    ranges = IRanges::IRanges(start = tb$pos, end = tb$pos),
    REF = tb$ref,
    ALT = tb$alt
  )
  
  GenomeInfoDb::genome(gr) <- "hg38"
  gr
}


write_matrix_tsv <- function(mat, path) {
  out <- as.data.frame(mat, check.names = FALSE) %>%
    tibble::rownames_to_column("context")
  
  readr::write_tsv(out, path)
}


