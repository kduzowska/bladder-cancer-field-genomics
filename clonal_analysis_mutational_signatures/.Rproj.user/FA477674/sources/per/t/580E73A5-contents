# 20. Paired Wilcoxon helper

paired_wilcoxon <- function(df, measure_col, measure, class_a, class_b) {
  sub <- df %>%
    dplyr::filter(
      .data[[measure_col]] == measure,
      classification %in% c(class_a, class_b),
      !is.na(relative_contribution)
    ) %>%
    dplyr::select(patient, classification, relative_contribution) %>%
    tidyr::pivot_wider(
      names_from = classification,
      values_from = relative_contribution
    ) %>%
    dplyr::filter(
      !is.na(.data[[class_a]]),
      !is.na(.data[[class_b]])
    )
  
  n_pairs <- nrow(sub)
  
  if (n_pairs == 0) {
    return(tibble::tibble(
      measure = measure,
      comparison = paste(class_a, "vs", class_b),
      n_pairs = 0L,
      n_nonzero_pairs = 0L,
      median_a = NA_real_,
      median_b = NA_real_,
      median_paired_difference = NA_real_,
      n_a_higher = 0L,
      n_b_higher = 0L,
      n_equal = 0L,
      statistic = NA_real_,
      p_value = NA_real_,
      note = "no paired patients"
    ))
  }
  
  x <- sub[[class_a]]
  y <- sub[[class_b]]
  difference <- x - y
  
  n_nonzero <- sum(difference != 0)
  n_a_higher <- sum(difference > 0)
  n_b_higher <- sum(difference < 0)
  n_equal <- sum(difference == 0)
  
  if (n_nonzero == 0) {
    statistic <- 0
    p_value <- 1
    note <- "all paired differences were zero"
  } else {
    fit <- suppressWarnings(
      stats::wilcox.test(x, y, paired = TRUE, exact = FALSE)
    )
    
    statistic <- unname(fit$statistic)
    p_value <- fit$p.value
    note <- NA_character_
  }
  
  tibble::tibble(
    measure = measure,
    comparison = paste(class_a, "vs", class_b),
    n_pairs = n_pairs,
    n_nonzero_pairs = n_nonzero,
    median_a = median(x),
    median_b = median(y),
    median_paired_difference = median(difference),
    n_a_higher = n_a_higher,
    n_b_higher = n_b_higher,
    n_equal = n_equal,
    statistic = statistic,
    p_value = p_value,
    note = note
  )
}

# 21. Individual signature comparisons

comparisons <- list(
  c("shared", "tumor_specific"),
  c("shared", "NAT_specific"),
  c("tumor_specific", "NAT_specific")
)

individual_tests <- purrr::map_dfr(comparisons, function(cmp) {
  purrr::map_dfr(SIGNATURE_PANEL, function(sig) {
    paired_wilcoxon(
      patient_contributions,
      measure_col = "signature",
      measure = sig,
      class_a = cmp[1],
      class_b = cmp[2]
    )
  })
}) %>%
  dplyr::group_by(comparison) %>%
  dplyr::mutate(
    p_adj_BH = p.adjust(p_value, method = "BH"),
    significant_BH = !is.na(p_adj_BH) & p_adj_BH < 0.05
  ) %>%
  dplyr::ungroup() %>%
  dplyr::arrange(comparison, p_value)

readr::write_tsv(
  individual_tests,
  file.path(OUT_DIR, "cluster_signature_individual_tests.tsv")
)

